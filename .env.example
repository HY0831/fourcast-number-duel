# HTTP server port, default 3001
PORT=3001
# Optional Socket.IO allowed frontend origin (defaults to all in development)
# CLIENT_ORIGIN=https://your-domain.example

# Optional: dedicated Playgrove PostgreSQL (leave UNSET to keep legacy in-memory rooms).
# Set only after provisioning an isolated database, with TLS as required by provider.
# Never commit a live database URL. Stored snapshots contain private player tokens.
# PLAYGROVE_DATABASE_URL=postgresql://playgrove_user:...@host:5432/playgrove?sslmode=require
