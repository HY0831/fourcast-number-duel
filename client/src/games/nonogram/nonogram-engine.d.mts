import type { NonogramPuzzle } from './puzzle-library.mjs';
export const MARK: Readonly<{ EMPTY: 0; FILL: 1; CROSS: 2 }>;
export const MAX_HINTS: number;
export type NonogramStatus = 'ready' | 'playing' | 'completed';
export type NonogramHistory = { marks: number[]; hints: number };
export type NonogramSession = { id: string; marks: number[]; seconds: number; hints: number; status: NonogramStatus; history: NonogramHistory[] };
export function runs(bits: Iterable<string | number>): number[];
export function cluesFor(puzzle: NonogramPuzzle): { rows: number[][]; columns: number[][] };
export function validatePuzzle(puzzle: NonogramPuzzle): boolean;
export function solutionCells(puzzle: NonogramPuzzle): number[];
export function filledTotal(puzzle: NonogramPuzzle): number;
export function correctlyFilled(puzzle: NonogramPuzzle, cells: number[]): number;
export function isSolved(puzzle: NonogramPuzzle, cells: number[]): boolean;
export function clueCompleted(puzzle: NonogramPuzzle, cells: number[], isRow: boolean, index: number): boolean;
export function freshSession(puzzle: NonogramPuzzle): NonogramSession;
export function restoreSession(input: unknown, puzzle: NonogramPuzzle): NonogramSession;
export function toggleMark(session: NonogramSession, puzzle: NonogramPuzzle, index: number, mode: 'fill' | 'cross'): NonogramSession;
export function undoMark(session: NonogramSession, puzzle: NonogramPuzzle): NonogramSession;
export function hintMark(session: NonogramSession, puzzle: NonogramPuzzle): NonogramSession;
export function lineCandidates(size: number, clues: number[]): number[];
export function countSolutions(puzzle: NonogramPuzzle, cap?: number): { count: number; solvedByPropagation: boolean; solution: string[] | null };
