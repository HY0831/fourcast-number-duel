export type Island={x:number;y:number;n:number};
export type Edge={a:number;b:number;horizontal:boolean};
export type HashiPuzzle={id:string;title:string;difficulty:'Easy'|'Medium'|'Hard';size:number;islands:Island[];edges:Edge[];solution:number[]};
export type Snapshot={bridges:number[];marks:boolean[];hints:number};
export type HashiSession={id:string;bridges:number[];marks:boolean[];hints:number;seconds:number;completed:boolean;history:Snapshot[];future:Snapshot[]};
export const MAX_HINTS:3;
export function buildEdges(islands:Island[]):Edge[];
export function edgesCross(puzzle:HashiPuzzle,i:number,j:number):boolean;
export function bridgeTotals(puzzle:HashiPuzzle,bridges:number[]):number[];
export function isSolved(puzzle:HashiPuzzle,bridges:number[]):boolean;
