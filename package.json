{
  "name": "fourcast-number-duel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first multiplayer four-digit guessing game",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit && npm test && npm run build"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "4.21.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}